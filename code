                    <td>Mr. Dineshnath.G</td>
                </tr>
                <tr>
                    <td>24SDCS02</td>
                    <td>Full Stack Application Development</td>
                    <td>Mr. Dineshnath.G</td>
                </tr>
                <tr>
                    <td>23SDC02A</td>
                    <td>Service Oriented Architecture using Microservices</td>
                    <td>Mr. Dineshnath.G</td>
                </tr>
            </tbody>
        </table>
    </main>
 
    <footer>
        <p>&copy; 2026 KLU</p>
    </footer>

    <script src="script.js"></script>
</body>
</html>
