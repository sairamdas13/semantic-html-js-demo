<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Semantic HTML + JS Demo</title>
    <style>
        body { font-family: Arial, sans-serif; padding: 20px; }
        header, footer { background: rgb(119, 0, 255); padding: 10px; text-align: center; }
        main { margin: 20px 0; }
        button { padding: 8px 16px; cursor: pointer; }
    </style>
</head>
<body>

    <!-- Semantic Tags -->
    <header>
        <h1>WELCOME TO KL PAGE</h1>
