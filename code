            <h2>Home Section</h2>
            <p>This paragraph will be updated by JavaScript.</p>
            <button onclick="runJS()">Click Me</button>
        </section>

        <section id="about">
            <h2>About Section</h2>
            <div id="output"></div>
        </section>
         <table border="5" style="margin: auto; text-align: center;">
